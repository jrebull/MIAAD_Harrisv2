\citation{bean}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Sweeping the SBX crossover spread $\eta _c$ for the real-coded NSGA-II on the visa problem. As $\eta _c$ falls (more disruptive crossover) the operator order-preservation $\tau $ drops, yet the mean hypervolume never reaches blind random restart (dashed) let alone the permutation tier (dotted); across the sweep $\tau $ and \textsf  {HV}\ are perfectly anti-correlated (Kendall $-1.0$). No crossover spread lets a random-key GA escape the random-key ceiling---only matching operators to the representation does.}}{15}{figure.6}\protected@file@percent }
\newlabel{fig:eta}{{6}{15}{Sweeping the SBX crossover spread $\eta _c$ for the real-coded NSGA-II on the visa problem. As $\eta _c$ falls (more disruptive crossover) the operator order-preservation $\tau $ drops, yet the mean hypervolume never reaches blind random restart (dashed) let alone the permutation tier (dotted); across the sweep $\tau $ and \HV \ are perfectly anti-correlated (Kendall $-1.0$). No crossover spread lets a random-key GA escape the random-key ceiling---only matching operators to the representation does}{figure.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Operator${}\times {}$architecture factorial on the visa problem: mean hypervolume (30 seeds) for three permutation operator sets crossed with three selection architectures, all under the matched budget. A two-way decomposition gives $\eta ^2=5.5\,\%$ (operator), $13.4\,\%$ (architecture), $2.9\,\%$ (interaction), $78.3\,\%$ (seed noise): both design axes are second-order once the representation is matched.}}{15}{table.6}\protected@file@percent }
\newlabel{tab:factorial}{{6}{15}{Operator${}\times {}$architecture factorial on the visa problem: mean hypervolume (30 seeds) for three permutation operator sets crossed with three selection architectures, all under the matched budget. A two-way decomposition gives $\eta ^2=5.5\,\%$ (operator), $13.4\,\%$ (architecture), $2.9\,\%$ (interaction), $78.3\,\%$ (seed noise): both design axes are second-order once the representation is matched}{table.6}{}}
\@writefile{toc}{\contentsline {paragraph}{An empirical regularity.}{15}{section*.19}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces The method ladder: 30 runs each, identical greedy decoder and $25{,}000$-evaluation budget. Top block: random-key encoding. Bottom block: permutation-native, spanning three distinct paradigms (swarm, decomposition, dominance/GA), which cluster within about $1\,\%$ and dominate every random-key method. Best per column in bold; ``perm-'' abbreviates ``permutation-''.}}{16}{table.7}\protected@file@percent }
\newlabel{tab:ladder}{{7}{16}{The method ladder: 30 runs each, identical greedy decoder and $25{,}000$-evaluation budget. Top block: random-key encoding. Bottom block: permutation-native, spanning three distinct paradigms (swarm, decomposition, dominance/GA), which cluster within about $1\,\%$ and dominate every random-key method. Best per column in bold; ``perm-'' abbreviates ``permutation-''}{table.7}{}}
