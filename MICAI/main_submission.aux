\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Generalization over six instances (base plus five $\pm 20\,\%$ perturbed-demand instances, P1--P5), each method's mean hypervolume shown as a percentage of MOHHO's on that instance. The ranking MOHHO $>$ random restart $>$ NSGA-II is preserved throughout, and FIFO is dominated on every instance.}}{18}{figure.8}\protected@file@percent }
\newlabel{fig:gen}{{8}{18}{Generalization over six instances (base plus five $\pm 20\,\%$ perturbed-demand instances, P1--P5), each method's mean hypervolume shown as a percentage of MOHHO's on that instance. The ranking MOHHO $>$ random restart $>$ NSGA-II is preserved throughout, and FIFO is dominated on every instance}{figure.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Mean Friedman rank (lower is better; 30 common seeds, paired) of each method on four structurally distinct multi-objective problems. A permutation-native method is best on every structure (\textbf  {bold}). The real-coded NSGA-II collapses below random restart only on the \emph  {selection} landscapes (visa, knapsack); on the \emph  {sequencing} landscapes (TSP, flow-shop) it is competitive and random restart is the worst method instead. ``rk'' $=$ random-key encoding, ``pm'' $=$ permutation-native.}}{19}{table.8}\protected@file@percent }
\newlabel{tab:structures}{{8}{19}{Mean Friedman rank (lower is better; 30 common seeds, paired) of each method on four structurally distinct multi-objective problems. A permutation-native method is best on every structure (\textbf {bold}). The real-coded NSGA-II collapses below random restart only on the \emph {selection} landscapes (visa, knapsack); on the \emph {sequencing} landscapes (TSP, flow-shop) it is competitive and random restart is the worst method instead. ``rk'' $=$ random-key encoding, ``pm'' $=$ permutation-native}{table.8}{}}
